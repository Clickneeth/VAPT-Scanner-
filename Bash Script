cat > ~/vapt_scanner.sh << 'EOF'
#!/usr/bin/env bash
# =============================================================================
#  VAPT Interactive Scanner
#  Author : G. Shankar Praneeth (126015102)
#  Usage  : bash vapt_scanner.sh
# =============================================================================

RED='\033[0;31m';  GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BLUE='\033[0;34m';  BOLD='\033[1m'; NC='\033[0m'

info()  { echo -e "${CYAN}[*]${NC} $1"; }
ok()    { echo -e "${GREEN}[+]${NC} $1"; }
warn()  { echo -e "${YELLOW}[!]${NC} $1"; }
err()   { echo -e "${RED}[-]${NC} $1"; }
bold()  { echo -e "${BOLD}$1${NC}"; }
line()  { echo -e "${BLUE}──────────────────────────────────────────────────${NC}"; }
has()   { command -v "$1" &>/dev/null; }

clear
echo -e "${BOLD}${CYAN}"
cat << 'BANNER'
 ██╗   ██╗ █████╗ ██████╗ ████████╗
 ██║   ██║██╔══██╗██╔══██╗╚══██╔══╝
 ██║   ██║███████║██████╔╝   ██║
 ╚██╗ ██╔╝██╔══██║██╔═══╝    ██║
  ╚████╔╝ ██║  ██║██║        ██║
   ╚═══╝  ╚═╝  ╚═╝╚═╝        ╚═╝
  Scanner — G. Shankar Praneeth (126015102)
BANNER
echo -e "${NC}"
line

# STEP 1 — Target
echo ""
bold "STEP 1 — Target"
echo -e "Enter the target domain (e.g. ${YELLOW}example.com${NC})"
read -rp "  Domain: " TARGET
TARGET="${TARGET// /}"
TARGET="${TARGET#http://}"
TARGET="${TARGET#https://}"
TARGET="${TARGET%%/*}"
[ -z "$TARGET" ] && err "No target entered." && exit 1
ok "Target set: $TARGET"

# STEP 2 — Subdomain permission
echo ""
line
bold "STEP 2 — Subdomain Scanning"
echo "  [1] Yes — scan subdomains"
echo "  [2] No  — skip"
read -rp "  Choice [1/2]: " SUB_CHOICE
SCAN_SUBS=false
[[ "$SUB_CHOICE" == "1" ]] && SCAN_SUBS=true && ok "Subdomain scanning enabled." || warn "Subdomain scanning skipped."

# STEP 3 — Output format
echo ""
line
bold "STEP 3 — Output Format"
echo "  [1] Markdown report file only"
echo "  [2] Terminal summary only"
echo "  [3] Both"
read -rp "  Choice [1/2/3]: " OUT_CHOICE
case "$OUT_CHOICE" in
    1) DO_FILE=true;  DO_TERM=false ;;
    2) DO_FILE=false; DO_TERM=true  ;;
    *) DO_FILE=true;  DO_TERM=true  ;;
esac

# STEP 4 — Module selection
echo ""
line
bold "STEP 4 — Select Modules"
echo "  [1] Recon      — whois, dig"
echo "  [2] Headers    — curl headers, CORS, HTTP methods"
echo "  [3] Ports      — nmap port + SSL scan"
echo "  [4] Fuzzing    — ffuf directory fuzzing"
echo "  [5] Tech       — httpx tech detection"
echo "  [6] Crawl      — katana + waybackurls"
echo "  [7] Vuln Scan  — nuclei templates"
echo "  [A] All modules"
echo ""
read -rp "  Enter numbers or A: " MODULE_INPUT
MODULE_INPUT="${MODULE_INPUT^^}"

run_mod() {
    [[ "$MODULE_INPUT" == *"A"* ]] && return 0
    [[ "$MODULE_INPUT" == *"$1"* ]] && return 0
    return 1
}

# SETUP
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
OUTDIR="vapt_${TARGET}_${TIMESTAMP}"
REPORT="${OUTDIR}/VAPT_Report_${TARGET}.md"
mkdir -p "${OUTDIR}"/{recon,headers,ports,fuzzing,tech,crawl,vulns}
FINDINGS=()
TOOL_ERRORS=()
append() { echo -e "$1" >> "$REPORT"; }
finding() { FINDINGS+=("| $1 | $2 | $3 | $4 |"); }

cat > "$REPORT" << HEADER
# VAPT Report
**Target:** \`${TARGET}\`
**Date:** $(date "+%d %B %Y — %H:%M")
**Tester:** G. Shankar Praneeth (126015102)
---
HEADER

echo ""
line
bold "  Starting scan on: $TARGET"
line
echo ""

# MODULE 1 — RECON
if run_mod 1; then
    info "MODULE 1 — Recon"
    append "## 1. Reconnaissance"
    if has whois; then
        whois "$TARGET" > "${OUTDIR}/recon/whois.txt" 2>&1 || true
        REG=$(grep -i "Registrar:" "${OUTDIR}/recon/whois.txt" 2>/dev/null | head -1 | cut -d: -f2- | xargs || echo "N/A")
        ok "  whois done"
        append "### 1.1 WHOIS"
        append "| Field | Value |"
        append "|-------|-------|"
        append "| Registrar | ${REG} |"
    else
        TOOL_ERRORS+=("whois"); warn "  whois not found"
    fi
    if has dig; then
        dig +short A "$TARGET" > "${OUTDIR}/recon/dig.txt" 2>&1
        A_REC=$(cat "${OUTDIR}/recon/dig.txt" | head -1)
        ok "  dig done — A record: ${A_REC:-none}"
        append "### 1.2 DNS A Record"
        append "\`\`\`"
        cat "${OUTDIR}/recon/dig.txt" >> "$REPORT"
        append "\`\`\`"
    else
        TOOL_ERRORS+=("dig"); warn "  dig not found"
    fi
fi

# MODULE 2 — HEADERS
if run_mod 2; then
    info "MODULE 2 — Headers"
    append "## 2. Security Headers"
    HDR=$(curl -sI --max-time 10 "https://${TARGET}" 2>/dev/null || curl -sI --max-time 10 "http://${TARGET}" 2>/dev/null || echo "")
    if [[ -n "$HDR" ]]; then
        echo "$HDR" > "${OUTDIR}/headers/raw.txt"
        SERVER=$(echo "$HDR" | grep -i "^Server:" | head -1 | tr -d '\r')
        CSP=$(echo "$HDR"    | grep -i "Content-Security-Policy" | head -1 | tr -d '\r')
        XFO=$(echo "$HDR"    | grep -i "X-Frame-Options" | head -1 | tr -d '\r')
        HSTS=$(echo "$HDR"   | grep -i "Strict-Transport" | head -1 | tr -d '\r')
        ok "  Headers retrieved"
        append "| Header | Status | Risk |"
        append "|--------|--------|------|"
        append "| Server | \`${SERVER:-hidden}\` | $([ -n "$SERVER" ] && echo 'Low' || echo 'OK') |"
        append "| CSP | $([ -n "$CSP" ] && echo 'Present' || echo 'MISSING') | $([ -n "$CSP" ] && echo 'OK' || echo 'Medium') |"
        append "| X-Frame-Options | $([ -n "$XFO" ] && echo 'Present' || echo 'MISSING') | $([ -n "$XFO" ] && echo 'OK' || echo 'Medium') |"
        append "| HSTS | $([ -n "$HSTS" ] && echo 'Present' || echo 'MISSING') | $([ -n "$HSTS" ] && echo 'OK' || echo 'Medium') |"
        [[ -z "$CSP"  ]] && finding "F1" "Missing Content-Security-Policy" "Medium" "Add CSP header"
        [[ -z "$XFO"  ]] && finding "F2" "Missing X-Frame-Options" "Medium" "Add X-Frame-Options"
        [[ -z "$HSTS" ]] && finding "F3" "Missing HSTS" "Medium" "Add Strict-Transport-Security"
        [[ -n "$SERVER" ]] && finding "F4" "Server Version Disclosure" "Low" "Hide server header"
        for METHOD in OPTIONS TRACE DELETE; do
            CODE=$(curl -s -o /dev/null -w "%{http_code}" -X "$METHOD" --max-time 8 "https://${TARGET}" 2>/dev/null || echo "ERR")
            append "| HTTP $METHOD | $CODE | $([ "$METHOD" == "TRACE" ] && [ "$CODE" == "200" ] && echo 'RISK' || echo 'OK') |"
        done
    else
        warn "  Could not reach $TARGET"
    fi
fi

# MODULE 3 — PORTS
if run_mod 3; then
    info "MODULE 3 — Port Scan (nmap)"
    append "## 3. Port Scan"
    if has nmap; then
        nmap -sV -T4 --top-ports 1000 "$TARGET" -oN "${OUTDIR}/ports/nmap.txt" 2>/dev/null || true
        ok "  nmap done"
        append "\`\`\`"
        grep "^[0-9].*open" "${OUTDIR}/ports/nmap.txt" 2>/dev/null >> "$REPORT" || echo "(none)" >> "$REPORT"
        append "\`\`\`"
    else
        TOOL_ERRORS+=("nmap"); warn "  nmap not found"
    fi
fi

# MODULE 4 — FUZZING
if run_mod 4; then
    info "MODULE 4 — Directory Fuzzing (ffuf)"
    append "## 4. Directory Fuzzing"
    WORDLIST="/usr/share/wordlists/dirb/common.txt"
    [ ! -f "$WORDLIST" ] && WORDLIST="/usr/share/dirb/wordlists/common.txt"
    if has ffuf && [ -f "$WORDLIST" ]; then
        ffuf -u "https://${TARGET}/FUZZ" -w "$WORDLIST" -mc 200,301,302,403 -t 50 -timeout 10 -s \
             -o "${OUTDIR}/fuzzing/ffuf.json" -of json 2>/dev/null || true
        ok "  ffuf done"
        append "\`\`\`"
        has jq && jq -r '.results[]? | "/\(.input.FUZZ) [\(.status)]"' "${OUTDIR}/fuzzing/ffuf.json" 2>/dev/null | head -20 >> "$REPORT" || echo "(check ffuf.json)" >> "$REPORT"
        append "\`\`\`"
    else
        TOOL_ERRORS+=("ffuf"); warn "  ffuf or wordlist not found"
    fi
fi

# MODULE 5 — TECH
if run_mod 5; then
    info "MODULE 5 — Tech Detection (httpx)"
    append "## 5. Tech Stack"
    if has httpx; then
        echo "$TARGET" | httpx -silent -title -tech-detect -status-code \
             -o "${OUTDIR}/tech/httpx.txt" 2>/dev/null || true
        ok "  httpx done"
        append "\`\`\`"
        cat "${OUTDIR}/tech/httpx.txt" >> "$REPORT" 2>/dev/null
        append "\`\`\`"
    else
        TOOL_ERRORS+=("httpx"); warn "  httpx not found"
    fi
fi

# MODULE 6 — CRAWL
if run_mod 6; then
    info "MODULE 6 — URL Crawl (katana + waybackurls)"
    append "## 6. URL Discovery"
    if has katana; then
        katana -u "https://${TARGET}" -d 2 -silent -o "${OUTDIR}/crawl/katana.txt" 2>/dev/null || true
        ok "  katana done"
        append "### Katana (top 20)"
        append "\`\`\`"
        head -20 "${OUTDIR}/crawl/katana.txt" >> "$REPORT" 2>/dev/null || echo "(none)" >> "$REPORT"
        append "\`\`\`"
    else
        TOOL_ERRORS+=("katana"); warn "  katana not found"
    fi
    if has waybackurls; then
        waybackurls "$TARGET" > "${OUTDIR}/crawl/wayback.txt" 2>/dev/null || true
        WB=$(wc -l < "${OUTDIR}/crawl/wayback.txt" 2>/dev/null || echo 0)
        ok "  waybackurls done — $WB URLs"
        append "### Wayback (top 20)"
        append "\`\`\`"
        head -20 "${OUTDIR}/crawl/wayback.txt" >> "$REPORT" 2>/dev/null || echo "(none)" >> "$REPORT"
        append "\`\`\`"
    else
        TOOL_ERRORS+=("waybackurls"); warn "  waybackurls not found"
    fi
fi

# MODULE 7 — NUCLEI
if run_mod 7; then
    info "MODULE 7 — Vulnerability Scan (nuclei)"
    append "## 7. Nuclei Scan"
    if has nuclei; then
        nuclei -u "https://${TARGET}" -severity low,medium,high,critical \
               -o "${OUTDIR}/vulns/nuclei.txt" -silent 2>/dev/null || true
        ok "  nuclei done"
        HIGH=$(grep -cEi "high|critical" "${OUTDIR}/vulns/nuclei.txt" 2>/dev/null || echo 0)
        append "**High/Critical findings:** $HIGH"
        append "\`\`\`"
        cat "${OUTDIR}/vulns/nuclei.txt" >> "$REPORT" 2>/dev/null || echo "(empty)" >> "$REPORT"
        append "\`\`\`"
    else
        TOOL_ERRORS+=("nuclei"); warn "  nuclei not found"
    fi
fi

# FINDINGS SUMMARY
append "---"
append "## Findings Summary"
if [[ ${#FINDINGS[@]} -eq 0 ]]; then
    append "_No findings recorded._"
else
    append "| ID | Finding | Risk | Recommendation |"
    append "|----|---------|------|----------------|"
    for ROW in "${FINDINGS[@]}"; do append "$ROW"; done
fi
append ""
append "_Report generated by vapt_scanner.sh — $(date)_"

# OUTPUT
echo ""
line
bold "  SCAN COMPLETE"
line
if [[ "$DO_TERM" == true ]]; then
    echo ""
    bold "  FINDINGS:"
    for ROW in "${FINDINGS[@]}"; do echo "  ${ROW//|/}"; done
    [ ${#TOOL_ERRORS[@]} -gt 0 ] && warn "  Missing tools: ${TOOL_ERRORS[*]}"
fi
if [[ "$DO_FILE" == true ]]; then
    echo ""
    ok "  Report: ${BOLD}$REPORT${NC}"
    ok "  Output: ${BOLD}$OUTDIR/${NC}"
fi
echo ""
line
EOF
chmod +x ~/vapt_scanner.sh
echo "✅ Done — run with: bash ~/vapt_scanner.sh"
